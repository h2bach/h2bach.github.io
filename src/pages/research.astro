---
import Layout from '../layouts/Layout.astro';
import { publications } from '../data/projects.js';
const base = import.meta.env.BASE_URL;
---
<Layout title="Research & publications | Hoang Huu Bach" active="Research">
  <section class="wrap page-intro"><p class="eyebrow">Research & publications</p><h1>Learning from complex data.</h1><p>Biological sequences, structured scientific data, constrained allocation, and anomaly detection. Four co-authored publications complement my work on data systems.</p></section>
  <section class="wrap section research-grid"><div><h2>MHPE</h2><p>Mixture-of-Experts modeling for peptide–HLA interactions and neoantigen candidate prioritization, combining BLOSUM62 encoding, BiLSTM, and cross-attention.</p><div class="tags"><span class="tag">BiLSTM</span><span class="tag">Cross-attention</span><span class="tag">Mixture-of-Experts</span></div><a class="text-link" href={`${base}projects/neoantigen/`}>Research case study</a></div><div><h2>Computer Science · UET-VNU</h2><p>M.Sc. (2024–2026), GPA 3.42/4, and B.Sc. (2019–2023), GPA 3.30/4. Master’s work focused on deep learning for neoantigen discovery; undergraduate work focused on somatic mutation calling from sequencing data.</p><p>Research and teaching support at the Department of Computational Science & Engineering since August 2023.</p></div></section>
  <section class="surface"><div class="wrap section"><p class="eyebrow">Publications</p><h2>Selected research record.</h2><ul class="publication-list" style="margin-top:30px">{publications.map(item => <li><strong><a href={item.url}>{item.title}</a></strong><small>{item.venue}</small></li>)}</ul></div></section>
</Layout>
