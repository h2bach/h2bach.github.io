---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Page not found | Hoang Huu Bach"><section class="wrap section"><p class="eyebrow">404</p><h1>Page not found.</h1><p>The requested page is unavailable. Browse the portfolio’s selected work or return home.</p><div class="actions"><a class="button" href={base}>Home</a><a class="button" href={`${base}projects/`}>Selected work</a></div></section></Layout>
