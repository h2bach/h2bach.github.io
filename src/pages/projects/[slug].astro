---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects.js';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Layout title={`${project.title} | Hoang Huu Bach`} description={project.summary} active="Work">
  <section class="wrap page-intro"><a class="back" href={`${base}projects/`}>Selected work</a><p class="eyebrow">{project.category}</p><h1>{project.title}</h1><p>{project.subtitle}. {project.summary}</p></section>
  <div class="wrap case-body">
    <aside class="case-aside" aria-label="Project context">
      <div class="block"><p class="label">Period</p>{project.period}<p class="label">My role</p>{project.role}</div>
      <div class="block"><p class="label">Technology</p><ul>{project.tags.map(tag => <li>{tag}</li>)}</ul></div>
      <div class="block">{project.repository && <a class="text-link" href={project.repository}>Repository</a>}{project.publication && <a class="text-link" href={project.publication}>Publication</a>}<p><a class="text-link" href={`${base}resume/`}>Resume</a></p></div>
    </aside>
    <article class="case-content">
      <h2>The question</h2><p>{project.question}</p>
      <h3>My contribution</h3><p>{project.contribution}</p>
      <div class="flow" aria-label="Implemented architecture">{project.flow.map(([title, detail]) => <div><strong>{title}</strong><small>{detail}</small></div>)}</div>
      {project.sections.map(section => <section><h2>{section.heading}</h2><p>{section.text}</p>{section.bullets && <ul>{section.bullets.map(bullet => <li>{bullet}</li>)}</ul>}{section.table && <div class="table-wrap"><table class="fact-table"><thead><tr>{section.table[0].map(cell => <th scope="col">{cell}</th>)}</tr></thead><tbody>{section.table.slice(1).map(row => <tr>{row.map(cell => <td>{cell}</td>)}</tr>)}</tbody></table></div>}</section>)}
    </article>
  </div>
</Layout>
