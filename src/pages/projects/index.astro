---
import Layout from '../../layouts/Layout.astro';
import { primaryProjects, supportingProjects } from '../../data/projects.js';
const base = import.meta.env.BASE_URL;
---
<Layout title="Selected work | Hoang Huu Bach" active="Work">
  <section class="wrap page-intro"><p class="eyebrow">Selected work</p><h1>Data systems & applied AI.</h1><p>MHPE and BQuant connect machine-learning depth with data engineering. BiodiversityVN adds experience extending a scientific data platform.</p></section>
  <section class="wrap section"><div class="primary-grid">{primaryProjects.map(project => <article class="primary-project"><p class="eyebrow">{project.slug === 'neoantigen' ? 'Applied machine learning' : 'Data systems & intelligent analytics'}</p><h3><a href={`${base}projects/${project.slug}/`}>{project.title}</a></h3><p class="category">{project.subtitle}</p><p>{project.summary}</p><div class="tags">{project.tags.map(tag => <span class="tag">{tag}</span>)}</div><div class="evidence-strip">{project.facts.map(([value, label]) => <span><strong>{value}</strong> {label}</span>)}</div><div class="project-links"><a class="text-link" href={`${base}projects/${project.slug}/`}>Read case study</a>{project.report && <a class="text-link" href={`${base}${project.report}`}>Market report</a>}{project.repository ? <a class="text-link" href={project.repository}>View code</a> : <a class="text-link" href={project.publication}>Publication</a>}</div></article>)}</div>{supportingProjects.map(project => <article class="project-row supporting-work"><div class="project-index">03</div><div><h3><a href={`${base}projects/${project.slug}/`}>{project.title}</a></h3><p class="category">Additional systems work</p><div class="tags">{project.tags.map(tag => <span class="tag">{tag}</span>)}</div></div><div><p>{project.summary}</p><div class="project-links"><a class="text-link" href={`${base}projects/${project.slug}/`}>Read case study</a><a class="text-link" href={project.repository}>View code</a></div></div></article>)}</section>
</Layout>
