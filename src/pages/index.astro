---
import Layout from '../layouts/Layout.astro';
import { primaryProjects, supportingProjects, experience, publications } from '../data/projects.js';
const base = import.meta.env.BASE_URL;
---
<Layout>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Hoang Huu Bach · M.Sc. Computer Science</p>
        <h1>Data engineering.<br/>Applied machine learning.</h1>
        <p class="intro">I build data systems and models that turn complex data into usable analysis. My work brings together Python pipelines, SQL analytics, and machine-learning research.</p>
        <div class="actions"><a class="button" href={`${base}projects/`}>Explore selected work</a><a class="button secondary" href={`${base}resume/`}>View resume</a></div>
      </div>
      <div class="paired-work" aria-label="Two primary projects">
        <a class="primary-panel" href={`${base}projects/neoantigen/`}><p class="panel-category">Applied machine learning</p><h2>MHPE</h2><p>Biological sequences → expert models → peptide–HLA prediction</p><span>Mixture-of-Experts · ICCBB 2025</span></a>
        <a class="primary-panel" href={`${base}projects/bquant/`}><p class="panel-category">Data systems & intelligent analytics</p><h2>BQuant</h2><p>Market data → quantitative signals → agents & portfolio optimization</p><span>Python · dbt · QAOA</span></a>
      </div>
    </div>
  </section>
  <div class="wrap stack" aria-label="Selected technologies"><span>Core toolkit</span><span>Python</span><span>SQL / dbt</span><span>DuckDB / Parquet</span><span>PyTorch</span><span>Plotly / Tableau</span></div>
  <section class="wrap section">
    <div class="section-heading"><div><p class="eyebrow">Featured work</p><h2>Models and the data behind them.</h2></div><a class="text-link" href={`${base}projects/`}>All case studies</a></div>
    <div class="primary-grid">{primaryProjects.map(project => <article class="primary-project">
      <p class="eyebrow">{project.slug === 'neoantigen' ? 'Applied machine learning' : 'Data systems & intelligent analytics'}</p>
      <h3><a href={`${base}projects/${project.slug}/`}>{project.title}</a></h3><p class="category">{project.subtitle}</p><p>{project.summary}</p>
      <div class="tags">{project.tags.map(tag => <span class="tag">{tag}</span>)}</div>
      <div class="project-links"><a class="text-link" href={`${base}projects/${project.slug}/`}>Read case study</a>{project.report && <a class="text-link" href={`${base}${project.report}`}>Market report</a>}{project.repository ? <a class="text-link" href={project.repository}>View code</a> : <a class="text-link" href={project.publication}>Publication</a>}</div>
    </article>)}</div>
    {supportingProjects.map(project => <article class="project-row supporting-work"><div class="project-index">03</div><div><h3><a href={`${base}projects/${project.slug}/`}>{project.title}</a></h3><p class="category">Additional systems work</p></div><div><p>{project.summary}</p><a class="text-link" href={`${base}projects/${project.slug}/`}>Read case study</a></div></article>)}
  </section>
  <section class="surface" id="experience"><div class="wrap section experience-grid">
    <div class="experience-intro"><p class="eyebrow">Experience</p><h2>Data work in context.</h2><p>Industry data operations, research engineering, and teaching experience built on a Computer Science foundation.</p><a class="text-link" href={`${base}resume/`}>Full resume</a></div>
    <div>{experience.map(item => <article class="timeline-item"><time>{item.date}</time><div><h3>{item.title}</h3><p class="company">{item.company}</p><p>{item.text}</p></div></article>)}</div>
  </div></section>
  <section class="wrap section research-grid">
    <div><p class="eyebrow">Research & machine learning</p><h2>Technical depth, grounded in experiments.</h2><p>My research explores biological sequence modeling, phylogenetic optimization, allocation algorithms, and anomaly detection.</p><p>MHPE combines BiLSTM, peptide–HLA cross-attention, and Mixture-of-Experts modeling for neoantigen prediction.</p><a class="text-link" href={`${base}research/`}>Research & publications</a></div>
    <ul class="publication-list">{publications.slice(0, 3).map(item => <li><strong><a href={item.url}>{item.title}</a></strong><small>{item.venue}</small></li>)}</ul>
  </section>
  <div class="wrap"><section class="contact"><div><h2>Let’s talk about data.</h2><p>Analytics engineering, data systems, and applied AI.</p></div><a class="button" href="mailto:hhbach01@gmail.com">hhbach01@gmail.com</a></section></div>
</Layout>
